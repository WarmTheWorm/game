{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "creator",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/serve.mjs",
        "creator",
        "--port=5180",
        "--no-open"
      ],
      "port": 5180
    },
    {
      "name": "static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5181",
        "--bind",
        "127.0.0.1"
      ],
      "port": 5181
    },
    {
      "name": "https",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/serve.mjs",
        "share",
        "--https",
        "--port=8443",
        "--no-open"
      ],
      "port": 8443,
      "url": "https://localhost:8443"
    }
  ]
}